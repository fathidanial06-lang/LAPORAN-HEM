# Environment variables for Laporan UNIT HEM MTAF
# Copy this file to `.env` and fill in your actual values.

# --- Option A: Supabase (PostgreSQL) — recommended for production ---
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
#
# Direct connection (IPv6, port 5432) — use if your host has IPv6 outbound:
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Session-mode pooler (IPv4, port 5432) — recommended for serverless / restricted networks:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1
#
# Transaction-mode pooler (IPv4, port 6543) — for edge functions:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Option B: Local SQLite (for quick prototyping only) ---
# DATABASE_URL=file:./db/custom.db
